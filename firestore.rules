rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read content for the public site
    match /articles/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /tickers/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /states/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
